# ==============================================================================
# Caddyfile (Docker, single container) — AI Arena router + dashboard
# ==============================================================================
# Companion to ../Caddyfile (host development, 127.0.0.1:<port>). Same route
# list and same 502 page. Two differences:
#   * the dashboard is served from /srv/aggregator inside this container;
#   * upstreams are the busybox httpd servers that supervisord keeps running in
#     this same container, one per model on 127.0.0.1:<port>.
#
# Caddy is the only process here that is reachable from outside (it publishes
# :8080). The 27 static servers listen on loopback only (127.0.0.1:5101-5127).
#
# Adding a model touches four places: ../Caddyfile, this file,
# aggregator/models.json and PORT_RULES.md. The supervisord program and its port
# are generated from models.json at image build time, so they stay in sync.
# ==============================================================================

(route_model) {
	redir /{args[0]} /{args[0]}/

	# Vite build uses base './', so assets are relative: strip the prefix before
	# handing the request to the model's static server.
	handle_path /{args[0]}/* {
		reverse_proxy 127.0.0.1:{args[1]}
	}
}

:8080 {
	# --------------------------------------------------------------------------
	# Model routes, in the same order as PORT_RULES.md
	# --------------------------------------------------------------------------
	import route_model gemini-3.7-flash 5101
	import route_model gemini-3.8-flash 5102
	import route_model deepseek-v4.1-flash-coreweave 5103
	import route_model deepseek-v4.1-flash-freebuff 5104
	import route_model deepseek-v4-flash-0731-coreweave 5105
	import route_model glm-5.2-coreweave 5106
	import route_model glm-5.3-flash-coreweave 5107
	import route_model glm-5.3-flash-freebuff 5108
	import route_model mimo-v2.6-flash 5109
	import route_model muse-spark-1.3-opencode 5110
	import route_model claude-sonnet-4.6-antigravity 5111
	import route_model claude-opus-4.6-antigravity 5112
	import route_model gpt-6-luna-codex 5113
	import route_model gpt-5.6-luna-codex 5114
	import route_model opus-5.5-cursor 5115
	import route_model grok-4.7-cursor 5116
	import route_model space-bunny-cline 5117
	import route_model longcat-2.5-opencode 5118
	import route_model gpt-6.1-sol-codex 5119
	import route_model gpt-6-astra-codex 5120
	import route_model glm-5.3-flash-zcode 5121
	import route_model ling-3.1-flash-opencode 5122
	import route_model fledge-alpha-opencode 5123
	import route_model claude-haiku-5.5-claude 5124
	import route_model claude-sonnet-5.5-claude 5125
	import route_model claude-opus-5.5-claude 5126
	import route_model kimi-k3-workbuddy 5127

	# --------------------------------------------------------------------------
	# Aggregator dashboard: ./aggregator is baked into the image at
	# /srv/aggregator (and mounted read-only over it in docker-compose.yml, so
	# the console can be edited without a rebuild).
	# --------------------------------------------------------------------------
	handle /models.json {
		root * /srv/aggregator
		file_server
	}

	handle /aggregator/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv/aggregator
		try_files {path} /index.html
		file_server
	}

	# --------------------------------------------------------------------------
	# Error handling
	# --------------------------------------------------------------------------
	handle_errors {
		respond "<h3>502 - Model Server Belum Aktif</h3><p>Server model ini belum siap di dalam container. Cek status di <a href='/'>Dashboard Utama</a>.</p><p><a href='/'>Kembali ke Dashboard Utama</a></p>" 502
	}
}
