# The Dockerfile copies each model folder by name (plus aggregator/), so nothing
# here can break the build. This file is only about build context size:
# everything listed below is either regenerated inside the image or has no
# business being in a container.

.git
.gitignore
.gitattributes

# Installed and rebuilt inside the image
**/node_modules
**/dist
**/dist-ssr
**/.vite

# Screenshots, logs, local state
**/.shots
**/*.log
**/*.local
**/.DS_Store
.freebuff

# Docs and orchestration files: never copied into any stage
docker-compose.yml
**/README.md
